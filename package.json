{
	"name": "tackl",
	"version": "4.2.0",
	"private": true,
	"description": "The ultimate Next.js starter kit!",
	"license": "MIT",
	"browserslist": [
		"baseline widely available"
	],
	"engines": {
		"node": ">=24.0.0"
	},
	"author": "joebentaylor1995",
	"sideEffects": [
		"*.css",
		"*.scss",
		"src/components/AnimationPlugins/**"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/12-studio/tackl"
	},
	"scripts": {
		"dev": "bun run styles && next dev --turbopack",
		"build": "bun run styles && next build",
		"start": "next start",
		"lint": "biome check . && stylelint \"**/*.scss\"",
		"lint:fix": "biome check --write . && stylelint \"**/*.scss\" --fix",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"type-check": "tsc --noEmit",
		"styles": "bun scripts/build-styles.ts",
		"storybook": "bun run styles && storybook dev -p 6006",
		"build-storybook": "bun run styles && storybook build",
		"serve": "serve ./out",
		"commit": "node .gitmessage.js",
		"prepare": "husky",
		"test": "playwright test",
		"lighthouse": "lhci autorun",
		"outdated": "bunx npm-check-updates"
	},
	"dependencies": {
		"@datocms/cda-client": "^0.2.10",
		"@gsap/react": "^2.1.2",
		"@sanity/vision": "^6.9.1",
		"graphql": "^17.0.2",
		"graphql-tag": "^2.12.7",
		"gsap": "^3.15.0",
		"lenis": "^1.3.26",
		"next": "^16.3.0",
		"next-sanity": "^13.3.1",
		"prompts": "^2.4.2",
		"react": "^19.2.8",
		"react-datocms": "^8.1.0",
		"react-dom": "^19.2.8",
		"sanity": "^6.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.62.1",
		"@storybook/addon-docs": "^10.5.7",
		"@storybook/addon-links": "^10.5.7",
		"@storybook/addon-onboarding": "^10.5.7",
		"@storybook/addon-themes": "^10.5.7",
		"@storybook/nextjs": "^10.5.7",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"ajv": "^8.20.0",
		"ajv-keywords": "^5.1.0",
		"husky": "^9.1.7",
		"sass-embedded": "^1.105.1",
		"storybook": "^10.5.7",
		"stylelint": "^17.16.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-value-no-unknown-custom-properties": "^6.1.1",
		"typescript": "~7.0.2"
	}
}
