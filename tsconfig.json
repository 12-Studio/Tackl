{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"paths": {
			"@/*": ["./src/*"],
			"@parts/*": ["./src/components/*"],
			"@css/*": ["./src/css/*"],
			"@cms": ["./src/cms"],
			"@cms/*": ["./src/cms/*"],
			"@tackl": ["./src/theme/tackl"],
			"@tackl/*": ["./src/theme/tackl/*"],
			"@waffl": ["./src/theme/tackl/waffl"],
			"@waffl/*": ["./src/theme/tackl/waffl/*"],
			"@theme": ["./src/theme"],
			"@theme/*": ["./src/theme/*"],
			"@utils/*": ["./src/utils/*"],
			"@public/*": ["./public/*"]
		},
		"plugins": [
			{
				"name": "next"
			}
		]
	},
	"include": [
		"app/**/*",
		"src/**/*",
		"sanity.config.ts",
		"sanity/**/*",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
