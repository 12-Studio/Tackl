{
	"name": "tackl",
	"version": "3.3.0",
	"description": "The ultimate Next.js starter kit!",
	"license": "MIT",
	"engines": {
		"node": ">=24.0.0"
	},
	"author": "joebentaylor1995",
	"sideEffects": [
		"*.css",
		"src/components/AnimationPlugins/**"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/12-studio/tackl"
	},
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"type-check": "tsc --noEmit",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"serve": "serve ./out",
		"commit": "node .gitmessage.js",
		"postinstall": "husky",
		"test": "echo \"No tests specified\" && exit 0",
		"lighthouse": "lhci autorun",
		"outdated": "bunx npm-check-updates"
	},
	"dependencies": {
		"@datocms/cda-client": "^0.2.10",
		"@gsap/react": "^2.1.2",
		"graphql": "^17.0.2",
		"graphql-tag": "^2.12.7",
		"gsap": "^3.15.0",
		"lenis": "^1.3.25",
		"next": "^16.2.10",
		"picocolors": "^1.1.1",
		"prompts": "^2.4.2",
		"react": "^19.2.7",
		"react-datocms": "^8.1.0",
		"react-dom": "^19.2.7",
		"styled-components": "^6.4.3",
		"tar": "^7.5.19"
	},
	"devDependencies": {
		"@lhci/cli": "^0.15.1",
		"@storybook/addon-docs": "^10.4.6",
		"@storybook/addon-links": "^10.4.6",
		"@storybook/addon-onboarding": "^10.4.6",
		"@storybook/addon-themes": "^10.4.6",
		"@storybook/nextjs": "^10.4.6",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@biomejs/biome": "^2.5.3",
		"ajv": "^8.20.0",
		"ajv-keywords": "^5.1.0",
		"husky": "^9.1.7",
		"storybook": "^10.4.6",
		"typescript": "6.0.3"
	},
	"husky": {
		"hooks": {
			"pre-commit": "bun run commit"
		}
	}
}
